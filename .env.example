DRIVE_ID=your_drive_id
DB_DATABASE=your_database
DB_USERNAME=local
DB_PASSWORD=your_password
DB_PORT=5432

# Configuração de Host:
# - Se for rodar na sua máquina (sem docker), coloque 'localhost' ou o IP do banco:
DB_HOST=localhost
# - Obs: Se for rodar via Docker Compose, o host 'db' já é sobrescrito e injetado automaticamente!
DB_SCHEMA=financeiro

# ==============================================================================
# Configurações de Docker & Servidor
# ==============================================================================
# Porta mapeada do PostgreSQL no host do servidor (padrão: 5433)
DB_PORT_MAPPING=5433

# Expressão do Cron para execução periódica do ETL no container
# Ex: '0 3 * * *' (todo dia às 03:00) ou '0 */6 * * *' (a cada 6 horas)
CRON_SCHEDULE=0 3 * * *

# Executa o ETL imediatamente na inicialização do container antes de aguardar o cron (true/false)
RUN_ON_STARTUP=true

# Configurações de Rede e Subnet
# O Docker Compose provisiona uma rede bridge isolada chamada etl-network com a subnet 172.20.0.0/24.
# O banco PostgreSQL recebe o IP fixo 172.20.0.2.
# O serviço do ETL recebe o IP fixo 172.20.0.3.

NETWORK_IP=172.20.0.3
NETWORK_SUBNET=172.20.0.0/29
NETWORK_GATEWAY=172.20.0.1


N8N_WEBHOOK_URL=seu_webhook